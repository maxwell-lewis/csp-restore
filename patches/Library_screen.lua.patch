+-- DISPLAY_WIDTH/HEIGHT are LOGICAL coordinates (despite the name): the game
+-- code uses them as world units (e.g. -DISPLAY_WIDTH/2 for the centered
+-- darken-screen rectangle in hudHandler.lua). They MUST stay at iPhone-
+-- native 480x320 even when we upscale the physical window. We introduce
+-- WINDOW_WIDTH/HEIGHT for actual pixel dimensions instead.
 DISPLAY_WIDTH, DISPLAY_HEIGHT = SCREEN_WIDTH, SCREEN_HEIGHT
+
+-- DESKTOP_UPSCALE_FACTOR (set in boot.lua before this file runs) increases
+-- the physical window size only. SCREEN_WIDTH/HEIGHT and DISPLAY_WIDTH/HEIGHT
+-- stay at logical iPhone values so all UI positioning, hit-testing, and
+-- per-frame world arithmetic keeps working. The OpenGL viewport upscales
+-- the logical canvas into the larger window automatically: setSize gets
+-- the physical pixel count, setScale stays at logical.
+WINDOW_WIDTH = DISPLAY_WIDTH
+WINDOW_HEIGHT = DISPLAY_HEIGHT
+if DESKTOP_UPSCALE_FACTOR and DESKTOP_UPSCALE_FACTOR > 1 then
+  WINDOW_WIDTH = SCREEN_WIDTH * DESKTOP_UPSCALE_FACTOR
+  WINDOW_HEIGHT = SCREEN_HEIGHT * DESKTOP_UPSCALE_FACTOR
+end
