+      briefing_a.texture = MOAITexture.new()
+      briefing_a.texture:load(hdBriefing)
+      local width, height = briefing_a.texture:getSize()
+      -- content occupies the middle 3/4 of the canvas vertically
+      local contentH = height * 0.75
+      local scale = (DESKTOP_BRIEFING_SCALE or (320 / contentH))
+      local hw, hh = width * scale / 2, height * scale / 2
+      briefing_a.tiledeck = MOAITileDeck2D.new()
+      briefing_a.tiledeck:setTexture(briefing_a.texture)
+      briefing_a.tiledeck:setSize(1, 1)
