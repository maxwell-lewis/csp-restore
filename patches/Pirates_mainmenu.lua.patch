+      voyageBriefing.backBtn.sprite:setScl(btnScale, btnScale)
+      voyageBriefing.backBtn.sprite:setLoc(-hw + 34, contentHalfH - 34)
+      layer:insertProp(voyageBriefing.backBtn.sprite)
+      voyageBriefing.startVoyageBtn.sprite:setParent(briefing_a.sprite)
+      voyageBriefing.startVoyageBtn.sprite:setScl(btnScale, btnScale)
+      voyageBriefing.startVoyageBtn.sprite:setLoc(hw - 78, -contentHalfH + 30)
+      layer:insertProp(voyageBriefing.startVoyageBtn.sprite)
+      if voyageBriefing.startVoyageBtn.text then
