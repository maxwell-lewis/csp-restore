+    -- If that single file is present we prefer it: fit its 4:3 content to the
+    -- 3:2 logical screen by height (320 / 768 = 0.4167), which renders the
+    -- full 1024 canvas at ~427 units wide -- inside the 480-wide screen with
+    -- a little margin either side. numPages is forced to 1 so the paging
+    -- arrows, swipe handling and page dots all disable themselves.
+    local hdBriefing = IMG_PATH .. "mission_" .. levelCount .. "/voyagebriefing_" .. levelCount .. ".png"
